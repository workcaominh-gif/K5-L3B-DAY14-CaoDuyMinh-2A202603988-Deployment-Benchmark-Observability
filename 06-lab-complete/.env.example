# ============================================================
# TODO (tiêu chí 9): liệt kê ĐỦ các biến môi trường app cần, KHÔNG ghi secret thật.
#   Bắt buộc có: AGENT_API_KEY, REDIS_URL, RATE_LIMIT_PER_MINUTE,
#                DAILY_BUDGET_USD (hoặc MONTHLY_BUDGET_USD)
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# ============================================================
PORT=8000
ENVIRONMENT=development

# API key client phải gửi qua header X-API-Key — đặt giá trị của riêng bạn, KHÔNG dùng giá trị mẫu này ở production
AGENT_API_KEY=dev-key

# Redis dùng cho rate limiter + cost guard. docker-compose trỏ sẵn tới service "redis".
REDIS_URL=redis://localhost:6379/0

# Tối đa bao nhiêu request / API key / 60 giây
RATE_LIMIT_PER_MINUTE=10

# Ngân sách chi phí LLM (USD). Vượt mức này -> 402.
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=30.0
